FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend /app/backend
COPY data /app/data
COPY artifacts /app/artifacts

ENV PYTHONUNBUFFERED=1

CMD ["python", "-c", "from backend.streaming.consumer import TransactionStreamConsumer; c = TransactionStreamConsumer(); c.initialize(); c.start_background_consumer(); import time; print('Streaming consumer running...'); time.sleep(999999)"]
