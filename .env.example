# ===============================================================
# REAL-TIME FINANCIAL FRAUD DETECTION PLATFORM CONFIGURATION
# ===============================================================

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Database Configuration
# Uses SQLite locally by default; switch to PostgreSQL in production/docker
DATABASE_URL=sqlite:///./fraud_detection.db

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INCOMING=transactions-incoming
KAFKA_TOPIC_SCORED=transactions-scored
KAFKA_TOPIC_ALERTS=fraud-alerts
KAFKA_TOPIC_ERRORS=transaction-errors
KAFKA_CONSUMER_GROUP=fraud-detection-engine
# Fallback to local in-memory event bus if Kafka broker is unavailable
KAFKA_FALLBACK_MODE=true

# Feature Store (Feast)
FEAST_REPO_PATH=backend/feature_store/feast_repo

# MLflow Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=fraud-detection-experiments

# Scoring & Risk Thresholds
FRAUD_THRESHOLD_LOW=0.30
FRAUD_THRESHOLD_HIGH=0.70
HYBRID_ALPHA=0.65  # XGBoost weight
HYBRID_BETA=0.35   # Graph Neural Network weight

# Model Artifact Paths
XGBOOST_MODEL_PATH=artifacts/xgboost/xgboost_fraud_model.json
GRAPH_MODEL_PATH=artifacts/graph/gnn_fraud_model.pt
SCALER_PATH=artifacts/xgboost/feature_scaler.joblib

# Monitoring & Drift
DRIFT_REPORT_DIR=data/reports
DRIFT_REFERENCE_DATA=data/processed/train_features.parquet
RETRAINING_DRIFT_THRESHOLD=0.25
RETRAINING_COOLDOWN_TRANSACTIONS=5000
